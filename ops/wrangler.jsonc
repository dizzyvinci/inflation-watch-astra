{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "inflation-watch-astra",
  "account_id": "7421e067d9f7155231fbe1bdc8311b03",
  "main": "./worker-entry.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "vars": {
    "PREVIEW_ACCESS": "review",
    "API_GRANT_JSON": "{\"enabled\":false,\"publicationEnabled\":false}"
  },
  "limits": {
    "cpu_ms": 1000
  },
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "inflation-watch-astra-data"
    },
    {
      "binding": "API_RAW_RECEIPTS",
      "bucket_name": "inflation-watch-astra-data"
    }
  ],
  "triggers": {
    "crons": [
      "3,13,23,33,43,53 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "API_BUDGET_OWNER",
        "class_name": "ApiGrantCollector"
      }
    ]
  },
  "migrations": [
    {
      "tag": "api-schema-probes-v1",
      "new_sqlite_classes": [
        "ApiGrantCollector"
      ]
    }
  ]
}
