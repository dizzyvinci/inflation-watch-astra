/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com/cdn-cgi/rum; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
# Defense against automatic analytics injection on known HTML entry paths.
# Dashboard auto-injection must also stay disabled; this permits manual opt-in only.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/index
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/404
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/404.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/version.json
  Cache-Control: public, max-age=0, must-revalidate
/data-*.json
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=86400
/astra-ui-*.js
  Cache-Control: public, max-age=31536000, immutable
/astra-ui-*.css
  Cache-Control: public, max-age=31536000, immutable
/astra-app-*.js
  Cache-Control: public, max-age=31536000, immutable
/fallback.html
  Cache-Control: public, max-age=60, stale-if-error=86400, no-transform
/fallback
  Cache-Control: public, max-age=60, stale-if-error=86400, no-transform
